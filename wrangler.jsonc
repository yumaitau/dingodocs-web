{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dingodocs-web",
  "account_id": "3eed46cc48f123cdff00d116df5e5070",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    {
      "pattern": "dingodocs.yumait.au",
      "custom_domain": true
    }
  ]
}
