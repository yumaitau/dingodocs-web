---
import { contactUrl } from '../data/site';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const legalLinks = [
  ['/eula', 'EULA'],
  ['/terms', 'Terms'],
  ['/privacy-policy', 'Privacy'],
  ['/refund-policy', 'Refunds'],
] as const;
---

<header class="site-header">
  <div class="shell nav">
    <a class="brand" href="/">
      <img class="brand-mark" src="/brand/dingodocs-logo-mark.png" width="28" height="28" alt="" />
      <span>DingoDocs</span>
    </a>
    {compact ? (
      <nav class="nav-links" aria-label="Legal documents">
        {legalLinks.map(([href, label]) => (
          <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    ) : (
      <nav class="nav-links" aria-label="Primary navigation">
        <a href="/#workflow">Workflow</a>
        <a href="/#mcp">MCP</a>
        <a href="/#deployment">Deployment</a>
      </nav>
    )}
    <a class="button button-small" href={contactUrl}>Book a call</a>
  </div>
</header>
