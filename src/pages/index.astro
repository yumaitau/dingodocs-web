---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { contactUrl, siteUrl, sourceUrl } from '../data/site';

const workflow = [
  ['Scope', 'Approve targets, rules, dates, and delivery responsibilities.'],
  ['Capture', 'Bring notes, scanner output, files, and evidence into the engagement.'],
  ['Review', 'Move findings through explicit authoring, peer review, and publication states.'],
  ['Report', 'Issue controlled, white-label reports with immutable version history.'],
  ['Verify', 'Track client remediation and complete evidence-backed retests.'],
];

const capabilities = [
  {
    className: 'capability capability-wide capability-earth',
    title: 'Assessment work stays connected',
    text: 'Scope, assets, notes, evidence, findings, tasks, time, QA, and reports remain attached to the engagement that produced them.',
    image: '/product/engagements.webp',
    imageAlt: 'DingoDocs engagement workspace showing delivery status and assessment progress',
  },
  {
    className: 'capability capability-tall',
    title: 'Evidence keeps its history',
    text: 'Classification, checksums, retention, legal holds, annotations, and links to findings remain visible and auditable.',
  },
  {
    className: 'capability',
    title: 'Clients see only approved material',
    text: 'Named client contacts receive engagement-specific access to shared findings, reports, evidence, remediation, and retests.',
  },
  {
    className: 'capability capability-image',
    title: 'Professional reports, under your brand',
    text: 'Render controlled PDF, DOCX, HTML, and Markdown deliverables from approved findings and evidence.',
    image: '/product/reports.webp',
    imageAlt: 'DingoDocs report workspace with an assessment report in internal review',
  },
  {
    className: 'capability capability-wide',
    title: 'Automation enters through governed interfaces',
    text: 'MCP and API credentials use explicit scopes. Scanner imports create drafts for human review rather than publishing directly to clients.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'DingoDocs',
    url: siteUrl,
    inLanguage: 'en-AU',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'DingoDocs',
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'Customer-controlled infrastructure',
    description: 'Self-hosted penetration testing engagement and reporting platform for scope, evidence, findings, reports, remediation, and retesting.',
    url: siteUrl,
    codeRepository: sourceUrl,
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
    publisher: {
      '@type': 'Organization',
      name: 'Yuma IT',
      url: 'https://www.yumait.com.au/',
    },
  },
];
---

<BaseLayout
  title="DingoDocs | Security assessment delivery, kept in context"
  description="Self-hosted penetration testing engagement and reporting software for scope, evidence, findings, reports, remediation, and retesting."
  schema={schema}
>
  <SiteHeader />
  <main id="main">
    <section class="hero">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Security assessment delivery</p>
          <h1>Run assessments from one place.</h1>
          <p>Keep scope, evidence, findings, reports, and remediation inside one customer-controlled, auditable workspace.</p>
          <div class="actions">
            <a class="button" href={contactUrl}>Book a call</a>
            <a class="button button-secondary" href="#workflow">See the workflow</a>
          </div>
        </div>
        <picture class="hero-art">
          <source media="(max-width: 760px)" srcset="/brand/dingodocs-banner-768.webp" />
          <img src="/brand/dingodocs-banner-1254.webp" width="1254" height="1254" alt="DingoDocs dingo carrying assessment evidence in the Australian outback" fetchpriority="high" />
        </picture>
      </div>
    </section>

    <section class="workflow-section" id="workflow" aria-labelledby="workflow-title">
      <div class="shell">
        <div class="section-heading">
          <h2 id="workflow-title">One record from scope to retest.</h2>
          <p>DingoDocs follows the work instead of splitting it across documents, tickets, storage drives, and client email.</p>
        </div>
        <ol class="workflow-list">
          {workflow.map(([title, text]) => (
            <li>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="product-section" aria-labelledby="product-title">
      <div class="shell">
        <div class="section-heading section-heading-narrow">
          <h2 id="product-title">See what needs attention.</h2>
          <p>The workspace surfaces delivery state, review work, risk, and deadlines without turning the assessment into another dashboard project.</p>
        </div>
        <figure class="product-frame">
          <picture>
            <source media="(max-width: 760px)" srcset="/product/dashboard-720.webp" />
            <img src="/product/dashboard-1440.webp" width="1440" height="900" alt="DingoDocs dashboard showing active engagements, reports in review, findings, and tasks" loading="lazy" />
          </picture>
          <figcaption>Operational overview for assessment teams.</figcaption>
        </figure>
      </div>
    </section>

    <section class="capabilities-section" id="capabilities" aria-labelledby="capabilities-title">
      <div class="shell">
        <div class="section-heading section-heading-narrow">
          <h2 id="capabilities-title">Built for defensible delivery.</h2>
          <p>Every important state is explicit: who can act, what clients can see, what changed, and which report version was approved.</p>
        </div>
        <div class="capability-grid">
          {capabilities.map((capability) => (
            <article class={capability.className}>
              <h3>{capability.title}</h3>
              <p>{capability.text}</p>
              {capability.image && (
                <img src={capability.image} width="1440" height="900" alt={capability.imageAlt} loading="lazy" />
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mcp-section" aria-labelledby="mcp-title">
      <div class="shell mcp-grid">
        <div class="mcp-copy">
          <h2 id="mcp-title">Capture from the tools testers already use.</h2>
          <p>Send notes, evidence, files, timeline events, finding drafts, and supported scanner output through DingoDocs MCP and API interfaces.</p>
          <p>Credentials carry defined scopes. Automated imports remain drafts until a person reviews and advances them.</p>
          <a class="text-link" href={sourceUrl}>Review the public source</a>
        </div>
        <figure class="detail-frame detail-frame-tall">
          <img src="/product/integrations.webp" width="1440" height="1504" alt="DingoDocs integrations and automation settings" loading="lazy" />
        </figure>
      </div>
    </section>

    <section class="review-section" aria-labelledby="review-title">
      <div class="shell review-grid">
        <figure class="detail-frame detail-frame-findings">
          <img src="/product/findings.webp" width="1440" height="1910" alt="DingoDocs finding authoring and review workspace" loading="lazy" />
        </figure>
        <div class="review-copy">
          <h2 id="review-title">Publishing is a deliberate state change.</h2>
          <p>Findings carry structured technical detail, impact, remediation, evidence, comments, ownership, and review history.</p>
          <ul class="check-list">
            <li>Draft and review states remain visible</li>
            <li>Reasoned overrides create audit records</li>
            <li>Client visibility is separate from publication</li>
            <li>Retests preserve the original finding version</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="deployment-section" id="deployment" aria-labelledby="deployment-title">
      <div class="shell deployment-panel">
        <div>
          <p class="eyebrow">Customer-controlled deployment</p>
          <h2 id="deployment-title">Your assessment data stays in your environment.</h2>
          <p>Operate DingoDocs inside your security boundary. Control identity, storage, access, backups, retention, integrations, and recovery.</p>
        </div>
        <div class="deployment-actions">
          <a class="button" href={contactUrl}>Book a call</a>
          <a class="button button-secondary" href={sourceUrl}>View source</a>
          <p>Community source uses Apache License 2.0. Contact Yuma IT for commercial and AWS Marketplace procurement.</p>
        </div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title">
      <div class="shell final-grid">
        <h2 id="final-title">Keep the assessment intact.</h2>
        <div>
          <p>See how DingoDocs fits your delivery model, client boundary, and reporting requirements.</p>
          <a class="button" href={contactUrl}>Book a call</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
