---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { contactUrl, siteUrl, sourceUrl } from '../data/site';

const mcpCalls = [
  ['capture_evidence', 'Stores terminal output and files against the engagement.'],
  ['ingest_scanner_results', 'Drafts findings from Nuclei, Nmap, Nessus, OpenVAS, ZAP, and Burp.'],
  ['create_finding_write_up', 'Writes the report body and keeps it in draft.'],
];

const record = [
  ['Evidence', 'Classification, checksums, retention, legal holds, annotations, and links to findings stay visible and auditable.'],
  ['Publishing', 'Draft and review states stay visible. Reasoned overrides create audit records. Client visibility is separate from publication.'],
  ['Client access', 'Named client contacts get engagement-specific access to shared findings, reports, evidence, remediation, and retests.'],
  ['Runbooks', 'Publish reusable procedures, apply immutable snapshots to engagements, and link each test step to evidence or findings.'],
  ['Risk views', 'Filter by severity, workflow state, age, deadline, and client exposure.'],
  ['Time zones', 'Dates are stored as UTC instants and shown in each user’s chosen IANA time zone.'],
];

const controls = ['Identity', 'Storage', 'Access', 'Backups', 'Retention', 'Integrations', 'Recovery'];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'DingoDocs',
    url: siteUrl,
    inLanguage: 'en-AU',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'DingoDocs',
    applicationCategory: 'SecurityApplication',
    operatingSystem: 'Customer-controlled infrastructure',
    description: 'Self-hosted penetration testing workspace where an MCP-capable agent captures evidence and finding drafts while it tests, then DingoDocs issues the reviewed report.',
    url: siteUrl,
    codeRepository: sourceUrl,
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
    publisher: {
      '@type': 'Organization',
      name: 'Yuma IT',
      url: 'https://www.yumait.com.au/',
    },
  },
];
---

<BaseLayout
  title="DingoDocs | The agent tests. The record stays."
  description="Point the MCP-capable agent you already use at DingoDocs. As it probes, fuzzes, and reads scanner output, it files evidence and finding drafts. You review, then issue the report."
  schema={schema}
>
  <SiteHeader />
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="shell hero-copy">
        <h1 id="hero-title"><span>Test with the agent.</span> <span>File as you go.</span></h1>
        <div class="hero-side">
          <p class="lede">Point the AI agent you already use at DingoDocs. As it probes, fuzzes, and reads scanner output, it saves the command, the output, and the finding draft to the engagement. You review. Then you issue the report.</p>
          <div class="actions">
            <a class="button" href={contactUrl}>Book a call</a>
            <a class="link" href="/marketing/dingodocs-marketing.pdf">Product brief (PDF)</a>
          </div>
          <ul class="facts" aria-label="Product facts">
            <li>Self-hosted</li>
            <li>MCP server included</li>
            <li>Apache-2.0 source</li>
          </ul>
        </div>
      </div>
      <figure class="hero-shot">
        <picture>
          <source media="(max-width: 47.99rem)" srcset="/product/dashboard-720.webp" width="720" height="450" />
          <img src="/product/dashboard-1440.webp" width="1440" height="900" alt="DingoDocs dashboard showing active engagements, reports in review, findings, and tasks" fetchpriority="high" />
        </picture>
      </figure>
    </section>

    <section class="stages" id="workflow" aria-labelledby="workflow-title">
      <div class="shell">
        <header class="stages-head">
          <h2 id="workflow-title">One record from scope to retest.</h2>
          <p>Five stages, one engagement. Nothing is split across documents, tickets, shared drives, and client email.</p>
        </header>

        <article class="stage">
          <div class="stage-text">
            <p class="stage-no">01 Scope</p>
            <h3>Agree what is in bounds.</h3>
            <p>Approve targets, rules of engagement, dates, and who delivers what. Assets, notes, tasks, and time stay attached to the engagement from here on.</p>
          </div>
          <figure class="shot">
            <img src="/product/engagements.webp" width="1440" height="900" alt="DingoDocs engagement workspace showing delivery status and assessment progress" loading="lazy" />
          </figure>
        </article>
      </div>

      <div class="band" id="mcp">
        <div class="shell stage stage-band">
          <div class="stage-text">
            <p class="stage-no">02 Capture</p>
            <h3>The agent tests. DingoDocs files.</h3>
            <p>Connect Grok, Claude, Cursor, or any MCP client with a scoped credential. While it runs Nuclei, Nmap, Burp, ZAP, or a fuzzer, it stores the input, the output, the note, and the write-up without leaving the session.</p>
            <dl class="calls">
              {mcpCalls.map(([name, text]) => (
                <div>
                  <dt><code>{name}</code></dt>
                  <dd>{text}</dd>
                </div>
              ))}
            </dl>
            <p class="band-note">Credentials carry defined scopes. Nothing reaches a client until a person advances the draft.</p>
            <a class="link" href={sourceUrl}>Read the MCP source</a>
          </div>
          <figure class="shot shot-crop">
            <img src="/product/integrations.webp" width="1440" height="1504" alt="DingoDocs integrations settings with the MCP server, API credentials, and webhooks" loading="lazy" />
          </figure>
        </div>
      </div>

      <div class="shell">
        <article class="stage">
          <div class="stage-text">
            <p class="stage-no">03 Review</p>
            <h3>Publishing is a deliberate state change.</h3>
            <p>Findings carry technical detail, impact, remediation, evidence, comments, ownership, and review history. Peer review and publication are explicit states, not a shared folder.</p>
          </div>
          <figure class="shot shot-crop">
            <img src="/product/findings.webp" width="1440" height="1910" alt="DingoDocs finding authoring and review workspace" loading="lazy" />
          </figure>
        </article>

        <article class="stage">
          <div class="stage-text">
            <p class="stage-no">04 Report</p>
            <h3>Issue the report under your brand.</h3>
            <p>Render controlled PDF, DOCX, HTML, and Markdown deliverables from the approved findings and evidence the work already produced.</p>
          </div>
          <figure class="shot">
            <img src="/product/reports.webp" width="1440" height="900" alt="DingoDocs report workspace with an assessment report in internal review" loading="lazy" />
          </figure>
        </article>

        <article class="stage stage-last">
          <div class="stage-text">
            <p class="stage-no">05 Verify</p>
            <h3>Retest against the original finding.</h3>
            <p>Track client remediation and complete evidence-backed retests. The retest keeps the finding version the client was given.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="record" id="record" aria-labelledby="record-title">
      <div class="shell record-grid">
        <h2 id="record-title">Also on the record.</h2>
        <dl class="spec">
          {record.map(([term, text]) => (
            <div>
              <dt>{term}</dt>
              <dd>{text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="deploy" id="deployment" aria-labelledby="deployment-title">
      <div class="shell deploy-grid">
        <div>
          <h2 id="deployment-title">Your assessment data stays in your environment.</h2>
          <p>Run DingoDocs inside your own security boundary. Contact Yuma IT for commercial terms and AWS Marketplace procurement.</p>
          <div class="actions">
            <a class="button" href={contactUrl}>Book a call</a>
            <a class="link" href={sourceUrl}>View source</a>
          </div>
        </div>
        <div class="controls">
          <p class="controls-label">You control</p>
          <ul>
            {controls.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
